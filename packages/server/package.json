{
  "name": "pi-web",
  "version": "0.1.0",
  "description": "Pi-Web: deploy and manage pi coding agents on SSH servers from a web UI",
  "type": "module",
  "bin": {
    "pi-web": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.3.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.6.0",
    "ssh2": "^1.17.0",
    "tar": "^7.5.0",
    "undici": "^8.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@pi-web/agent": "*",
    "@pi-web/shared": "*",
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
